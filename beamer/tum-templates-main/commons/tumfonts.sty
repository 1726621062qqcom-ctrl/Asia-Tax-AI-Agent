\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tumfonts}[2024/05/24 v3.0]


% .:: Load required packages
% ----------------------------------------------------------------------------

\RequirePackage{pgfkeys}
\RequirePackage{pgfopts}
\RequirePackage{iftex}


% .:: Package options for tumfonts package
% ----------------------------------------------------------------------------
% font: helvet (default), times, palatino, libertine

\newcounter{@tum@textfont@number@}

\pgfqkeys{/TUM/fonts}{
  textfont/.is choice,
  textfont/helvet/.code = {\setcounter{@tum@textfont@number@}{1}},
  textfont/times/.code = {\setcounter{@tum@textfont@number@}{2}},
  textfont/palatino/.code = {\setcounter{@tum@textfont@number@}{3}},
  textfont/libertine/.code = {\setcounter{@tum@textfont@number@}{4}},
  font/.forward to = /TUM/fonts/textfont,
}

% set default options
\pgfqkeys{/TUM/fonts}{font=helvet}

% process package options
\ProcessPgfOptions{/TUM/fonts}

% print debug info to logfile
\typeout{Global options after tumfonts option parsing.}
\typeout{classoptions: \@classoptionslist}
\typeout{unused classoptions: \@unusedoptionlist}


% .:: Handle package options
% ----------------------------------------------------------------------------

\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  % define macro to enable helvetica font
  \newcommand{\theTUMFont}{%
    \fontfamily{qhv}\fontsize{10pt}{12pt}\selectfont%
  }
  % handle text font package option
  \ifcase\the@tum@textfont@number@\relax
  \or % helvet
    \RequirePackage[scale=0.96]{tgheros}
    \RequirePackage[scale=1.10]{newtxtt}
    \RequirePackage{amsmath}
    \RequirePackage{amssymb}
    \RequirePackage{upgreek}
    \RequirePackage{esint}
    \renewcommand{\familydefault}{\sfdefault}
  \or % times
    \RequirePackage[largesc, helvratio=0.96]{newtxtext}
    \RequirePackage[varbb]{newtxmath}
    \RequirePackage[scale=1.06]{newtxtt}
    \renewcommand{\familydefault}{\rmdefault}
  \or % palatino
    \RequirePackage[largesc, helvratio=0.96]{newpxtext}
    \RequirePackage[varbb]{newpxmath}
    \RequirePackage[scale=1.06]{newtxtt}
    \renewcommand{\familydefault}{\rmdefault}
  \or % libertine
    \RequirePackage{libertinus}
    \RequirePackage[libertine, varbb]{newtxmath}
    \RequirePackage[scale=0.96]{tgheros}
    \RequirePackage[scale=1.04]{newtxtt}
    \renewcommand{\familydefault}{\rmdefault}
  \fi
\else
  \RequirePackage{fontspec}
  \RequirePackage[math-style=ISO, bold-style=ISO]{unicode-math}
  % the sans font should always be helvetica
  \setsansfont{TeX Gyre Heros}[Scale=0.96]
  % define macro to enable helvetica font
  \newcommand{\theTUMFont}{%
    \fontspec{TeX Gyre Heros}\fontsize{10pt}{12pt}\selectfont%
  }
  % handle text font package option
  \ifcase\the@tum@textfont@number@\relax
  \or % helvet
    \setmainfont{New CM 10 Book}[Scale=1.04]
    \setmathfont{New CM Math Book}[Scale=1.04]
    \setmonofont{New CM Mono 10 Book}[Scale=1.16]
    \renewcommand{\familydefault}{\sfdefault}
  \or % times
    \setmainfont{TeX Gyre Termes}
    \setmathfont{XITS Math}
    \setmonofont{New CM Mono 10 Book}[Scale=MatchLowercase]
  \or % palatino
    \setmainfont{TeX Gyre Pagella}
    \setmathfont{TeX Gyre Pagella Math}
    \setmonofont{New CM Mono 10 Book}[Scale=MatchLowercase]
  \or % libertine
    \setmainfont{Libertinus Serif}
    \setmathfont{Libertinus Math}
    \setmonofont{New CM Mono 10 Book}[Scale=MatchLowercase]
  \fi
\fi
