# Copy to .env and adjust as needed. .env is git-ignored.
# Cloud PostgreSQL: copy the Supabase Session pooler URI and use psycopg.
FSIE_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Model input: synthetic case facts; public HK official excerpts in the source
# manifest are authorized for DeepSeek summaries (2026-10-03). No real customer
# data is authorized by this exception. Keys must never be committed.
FSIE_MODEL_BASE_URL=
FSIE_MODEL_API_KEY=
FSIE_MODEL_NAME=

# Chat state uses FSIE_DATABASE_URL by default.
# Set this explicitly for an independent PostgreSQL chat database if desired.
# Changing this URL does not migrate existing conversations automatically.
# FSIE_WEB_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Enable only behind HTTPS when deploying with an approved authentication design.
FSIE_WEB_SECURE_COOKIE=false

# Supabase email authentication. Use Publishable/anon key, NEVER service_role.
FSIE_AUTH_SUPABASE_URL=
FSIE_AUTH_PUBLISHABLE_KEY=
FSIE_AUTH_SITE_URL=http://127.0.0.1:8000
# Set true for HTTPS deployment.
FSIE_AUTH_SECURE_COOKIE=false

# B orchestration. Enable tools in a test environment before rollout.
FSIE_AGENT_ORCHESTRATION=hybrid
FSIE_AGENT_DYNAMIC_PLANNER=false
FSIE_AGENT_HARNESS_MODE=rewrite
# To enable the business tool loop: dynamic_planner=true, harness_mode=tools.
# C retrieval stays behind KnowledgeProvider; no MCP or direct model SQL.

# Optional Li 771e452 integration. Keep the full release (tax_graph/ plus official/)
# outside this repository; the bridge verifies the shipped source/CSV and LFS DB.
# FSIE_LI_RELEASE_DIR=/absolute/path/to/Asia-Tax-AI-Agent-LiZiheng-771e452
# FSIE_LI_TIMEOUT_SECONDS=40
# Run the read-only service on 127.0.0.1:8010 before enabling the C provider.
# FSIE_AGENT_PROVIDER=combined
# FSIE_AGENT_C_URL=http://127.0.0.1:8010
# FSIE_AGENT_C_TOKEN=local-shared-token

# Reviewer Supabase UUIDs; defaults to no review access.
# FSIE_AGENT_REVIEWER_IDS=[]
# The installer default is data/li/releases/<pinned commit>; release_dir is optional.
